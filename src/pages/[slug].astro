---
import Layout from '@/components/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('posts');
const otherPosts = allPosts.filter((p) => p.id !== post.id);
const currentTags = post.data.tags || [];

// 1. Related: posts with matching tags
const relatedPosts = otherPosts
  .map((p) => {
    const matchCount = (p.data.tags || []).filter((t: string) => currentTags.includes(t)).length;
    return { ...p, matchCount };
  })
  .filter((p) => p.matchCount > 0)
  .sort((a, b) => b.matchCount - a.matchCount)
  .slice(0, 3);

// 2. Random: random picks from non-related posts
const relatedIds = new Set(relatedPosts.map(p => p.id));
const nonRelated = otherPosts.filter(p => !relatedIds.has(p.id));
const randomPosts = [...nonRelated].sort(() => Math.random() - 0.5).slice(0, 3);

// 3. Latest: most recent from all other posts (not just non-related)
const latestPosts = [...otherPosts]
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const wordCount = post.body?.split(/\s+/).length ?? 0;
const readTime = Math.max(1, Math.ceil(wordCount / 180));

// Extract h2 headings for TOC
const headings = (post.body || '').match(/<h2\s+id="([^"]+)"[^>]*>(.+?)<\/h2>/g) || [];
const toc = headings.map((h) => {
  const idMatch = h.match(/id="([^"]+)"/);
  const textMatch = h.match(/<h2[^>]*>(.+?)<\/h2>/);
  return { id: idMatch?.[1] || '', text: textMatch?.[1]?.replace(/&amp;/g, '&') || '' };
});

// Tag label mapping
const tagLabels: Record<string, string> = {
  'release-notes': 'Release Notes',
  'tips-deepin': 'Tips deepin',
  'komunitas-update': 'Komunitas Update',
  'event': 'Event',
};
---

<Layout title={post.data.title} description={post.data.description} image={post.data.image} type="article" date={post.data.date.toISOString()} authorName={post.data.author} tags={post.data.tags}>
  <article class="bg-white">
    {/* Soft gradient header */}
    <div class="bg-gradient-to-b from-deepin-50 to-white pt-10 pb-4">
      <div class="container-main max-w-3xl">
        {/* Back link */}
        <a href="/" class="inline-flex items-center gap-1.5 text-sm text-deepin-600 hover:text-deepin-800 font-medium mb-4 transition-colors">
          <i class="fas fa-arrow-left text-xs" /> Kembali ke News
        </a>

        {/* Tags */}
        <div class="flex gap-2 mb-4">
          {post.data.tags?.map((tag: string) => (
            <a href={`/?tag=${tag}`} class="px-3 py-1.5 rounded-full bg-deepin-100 text-deepin-700 text-xs font-semibold hover:bg-deepin-200 transition-colors">
              {tagLabels[tag] || tag}
            </a>
          ))}
        </div>

        {/* Title */}
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 leading-tight">{post.data.title}</h1>
      </div>
    </div>

    <div class="container-main max-w-3xl pb-10 relative">
      {/* Card Container */}
      <div class="bg-white -mt-0">
        <div class="flex flex-wrap items-center gap-4 text-sm text-gray-400 mb-8 pb-8 border-b border-gray-100">
          <span class="inline-flex items-center gap-1.5"><i class="far fa-calendar text-xs" /> {new Date(post.data.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
          <span class="inline-flex items-center gap-1.5"><i class="far fa-user text-xs" /> {post.data.author}</span>
          <span class="inline-flex items-center gap-1.5"><i class="far fa-clock text-xs" /> {readTime} menit baca</span>
        </div>

        <div class="prose prose-gray max-w-none
          prose-headings:font-bold prose-headings:text-gray-900 prose-headings:mt-8 prose-headings:mb-3 prose-headings:scroll-mt-20
          prose-h2:text-xl prose-h2:border-b prose-h2:border-gray-100 prose-h2:pb-2
          prose-h3:text-lg
          prose-p:text-gray-600 prose-p:leading-relaxed prose-p:mb-4 prose-p:text-[15px]
          prose-a:text-deepin-600 prose-a:no-underline hover:prose-a:underline prose-a:font-medium
          prose-img:rounded-xl prose-img:shadow-md prose-img:my-6 prose-img:mx-auto prose-img:block
          prose-pre:bg-gray-900 prose-pre:text-gray-100 prose-pre:rounded-xl prose-pre:shadow-lg prose-pre:text-sm
          prose-code:bg-gray-100 prose-code:text-deepin-700 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:text-sm prose-code:font-normal
          prose-code:before:content-none prose-code:after:content-none
          [&_pre_code]:bg-transparent [&_pre_code]:text-gray-100 [&_pre_code]:px-0 [&_pre_code]:py-0 [&_pre_code]:rounded-none
          prose-table:border-collapse prose-th:bg-gray-50 prose-th:px-4 prose-th:py-2.5 prose-th:text-left prose-th:text-xs prose-th:font-semibold prose-th:text-gray-500 prose-th:uppercase
          prose-td:px-4 prose-td:py-2.5 prose-td:text-sm prose-td:text-gray-600 prose-td:border-t prose-td:border-gray-100
          prose-li:text-gray-600 prose-li:text-[15px] prose-li:leading-relaxed
          prose-blockquote:border-l-4 prose-blockquote:border-deepin-500 prose-blockquote:bg-deepin-50 prose-blockquote:px-5 prose-blockquote:py-3 prose-blockquote:rounded-r-xl prose-blockquote:not-italic prose-blockquote:text-gray-600 prose-blockquote:text-[15px]
          prose-strong:text-gray-900 prose-strong:font-semibold
          prose-hr:border-gray-100
          [&_details]:my-5 [&_details]:rounded-xl [&_details]:border [&_details]:border-gray-200 [&_details]:overflow-hidden
          [&_summary]:cursor-pointer [&_summary]:font-semibold [&_summary]:text-gray-800 [&_summary]:bg-gray-50 [&_summary]:px-5 [&_summary]:py-3 [&_summary]:text-sm
          [&_details[open]_summary]:border-b [&_details[open]_summary]:border-gray-200
          [&_details>p]:px-5 [&_details>p]:pb-3 [&_details>p]:pt-2
          [&_iframe]:rounded-xl [&_iframe]:shadow-lg [&_iframe]:my-6 [&_iframe]:w-full [&_iframe]:aspect-video [&_iframe]:h-auto
          [&_table]:w-full [&_table]:my-5 [&_table]:rounded-xl [&_table]:overflow-hidden [&_table]:border [&_table]:border-gray-200
          [&_p:has(+_p_em)]:mb-1
          [&_p_+_p_>em]:block [&_p_+_p_>em]:text-center [&_p_+_p_>em]:text-sm [&_p_+_p_>em]:text-gray-400 [&_p_+_p_>em]:mt-0 [&_p_+_p_>em]:-mt-4 [&_p_+_p_>em]:mb-6
          [&_figcaption]:text-center [&_figcaption]:text-sm [&_figcaption]:text-gray-400 [&_figcaption]:mt-2 [&_figcaption]:mb-6
        ">
          <Content />
        </div>

      {/* Share + CTA */}
      <div class="mt-8 pt-6 border-t border-gray-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <p class="text-sm font-semibold text-gray-500 mb-3">Bagikan artikel:</p>
          <div class="flex gap-2">
            {[
              { name: 'Telegram', icon: 'fab fa-telegram-plane', url: `https://t.me/share/url?url=${Astro.url.href}&text=${encodeURIComponent(post.data.title)}`, color: 'hover:bg-[#0088cc] hover:text-white' },
              { name: 'WhatsApp', icon: 'fab fa-whatsapp', url: `https://wa.me/?text=${encodeURIComponent(post.data.title + ' ' + Astro.url.href)}`, color: 'hover:bg-[#25D366] hover:text-white' },
              { name: 'X', icon: 'fab fa-x-twitter', url: `https://x.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(Astro.url.href)}`, color: 'hover:bg-black hover:text-white' },
              { name: 'Facebook', icon: 'fab fa-facebook', url: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`, color: 'hover:bg-[#1877F2] hover:text-white' },
            ].map((s) => (
              <a href={s.url} target="_blank" rel="noopener" class={`w-10 h-10 rounded-xl border border-gray-200 flex items-center justify-center text-gray-400 transition-all ${s.color}`} title={s.name}>
                <i class={`${s.icon} text-sm`} />
              </a>
            ))}
          </div>
        </div>
        <a href="https://t.me/Linux_deepin_ID" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-[#0088cc] text-white text-sm font-semibold hover:bg-[#0077b5] transition-all hover:-translate-y-0.5 shadow-md">
          <i class="fab fa-telegram-plane" /> Gabung Komunitas
        </a>
      </div>
      </div>

      {/* TOC Sidebar — floating di kanan, ala Medium */}
      {toc.length > 0 && (
        <aside class="hidden xl:block absolute top-0 right-0 translate-x-[calc(100%+2rem)] w-52" id="toc-sidebar">
          <div class="sticky top-[88px]">
            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Daftar Isi</p>
            <nav class="border-l-2 border-gray-200" id="toc-nav">
              {toc.map((item) => (
                <a
                  href={`#${item.id}`}
                  class="block py-1.5 pl-3 -ml-0.5 text-sm text-gray-500 hover:text-deepin-600 border-l-2 border-transparent hover:border-deepin-400 transition-all toc-link"
                  data-toc={item.id}
                >
                  {item.text}
                </a>
              ))}
            </nav>
          </div>
        </aside>
      )}
    </div>
  </article>

  {/* Post Sections */}
  {[
    { title: 'Artikel Terkait', icon: 'fa-link', posts: relatedPosts },
    { title: 'Artikel Random', icon: 'fa-shuffle', posts: randomPosts },
    { title: 'Artikel Terbaru', icon: 'fa-clock', posts: latestPosts },
  ].map((section) => section.posts.length > 0 && (
    <section class="py-8 bg-gray-50">
      <div class="container-main max-w-5xl">
        <h3 class="text-xl font-extrabold text-gray-900 mb-8 text-center">
          {section.title}
        </h3>
        <div class={`grid gap-5 ${section.posts.length === 1 ? 'grid-cols-1 max-w-sm mx-auto' : section.posts.length === 2 ? 'sm:grid-cols-2 max-w-2xl mx-auto' : 'sm:grid-cols-3'}`}>
          {section.posts.map((r) => (
            <a href={`/news/${r.id}`} class="card overflow-hidden group hover:-translate-y-1 transition-all duration-300">
              <div class="h-40 bg-gradient-to-br from-deepin-400 to-deepin-600 flex items-center justify-center overflow-hidden">
                {r.data.image ? (
                  <img src={r.data.image} alt={r.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                ) : (
                  <i class="fas fa-newspaper text-3xl text-white/30" />
                )}
              </div>
              <div class="p-5">
                <h4 class="font-semibold text-gray-900 group-hover:text-deepin-600 transition-colors text-sm line-clamp-2 mb-2">{r.data.title}</h4>
                <div class="flex items-center gap-3 text-xs text-gray-400">
                  <span><i class="far fa-calendar mr-1" /> {new Date(r.data.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                  {r.data.tags?.map((t: string) => (
                    <span class="px-2 py-0.5 rounded-full bg-deepin-50 text-deepin-600 text-[10px] font-medium">{tagLabels[t] || t}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
</Layout>

<script>
  // Scroll spy for TOC sidebar
  const tocLinks = document.querySelectorAll('.toc-link');
  if (tocLinks.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const link = document.querySelector(`.toc-link[data-toc="${entry.target.id}"]`);
          if (link) {
            if (entry.isIntersecting) {
              document.querySelectorAll('.toc-link').forEach((l) => {
                l.classList.remove('text-deepin-600', 'border-deepin-500', 'font-semibold');
                l.classList.add('text-gray-500', 'border-transparent');
              });
              link.classList.remove('text-gray-500', 'border-transparent');
              link.classList.add('text-deepin-600', 'border-deepin-500', 'font-semibold');
            }
          }
        });
      },
      { rootMargin: '-80px 0px -70% 0px' }
    );

    tocLinks.forEach((link) => {
      const id = link.getAttribute('data-toc');
      const target = document.getElementById(id || '');
      if (target) observer.observe(target);
    });
  }
</script>
