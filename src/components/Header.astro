---
import { MAIN_NAV, ABOUT_NAV } from '@/data/site';

const currentPath = Astro.url.pathname;
const currentUrl = Astro.url.href;
const langLabel: Record<string, string> = {
  'id': '🇮🇩 Indonesia',
  'en': '🇬🇧 English',
  'zh-CN': '🇨🇳 中文',
};
const langMore: Record<string, string> = {
  'ja': '🇯🇵 日本語',
  'ko': '🇰🇷 한국어',
  'ar': '🇸🇦 العربية',
  'ru': '🇷🇺 Русский',
  'pt': '🇧🇷 Português',
  'fr': '🇫🇷 Français',
  'de': '🇩🇪 Deutsch',
  'es': '🇪🇸 Español',
};
const langKeys = ['id', 'en', 'zh-CN'];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-xl border-b-2 border-gray-200 shadow-[0_1px_3px_rgba(0,0,0,0.08)]" id="header">
  <nav class="container-main flex items-center justify-between h-[72px]" aria-label="Main">
    <!-- Logo -->
    <a href="https://deepin.id" class="flex items-center shrink-0" aria-label="deepin Indonesia home">
      <img
        src="/images/deepin-id-text.png"
        alt="deepin Indonesia"
        width="138"
        height="34"
        class="h-8 w-auto"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </a>

    <!-- Desktop Nav -->
    <div class="hidden lg:flex items-center gap-1">
      {MAIN_NAV.map((item) => (
        item.children ? (
          <div class="relative group">
            <button class="btn-ghost text-sm font-medium py-2">
              {item.title}
              <i class="fas fa-chevron-down text-[10px] ml-1 opacity-50 group-hover:rotate-180 transition-transform" />
            </button>
            <div class="absolute top-full left-0 mt-1 bg-white rounded-xl border border-gray-100 shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 min-w-[200px] py-2">
              {item.children.map((child) => (
                <a href={child.url} class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-deepin-600 transition-colors">
                  {child.title}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.url} class="btn-ghost text-sm font-medium py-2" target="_blank" rel="noopener">
            {item.title}
          </a>
        )
      ))}

      <!-- Tentang deepin Dropdown -->
      <div class="relative group">
        <button class="btn-ghost text-sm font-medium py-2">
          Tentang deepin
          <i class="fas fa-chevron-down text-[10px] ml-1 opacity-50 group-hover:rotate-180 transition-transform" />
        </button>
        <div class="absolute top-full right-0 mt-1 bg-white rounded-xl border border-gray-100 shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 min-w-[220px] py-2">
          {ABOUT_NAV[0].children?.map((child) => (
            <a href={child.url} class={`block px-4 py-2 text-sm hover:bg-gray-50 hover:text-deepin-600 transition-colors ${child.highlight ? 'text-deepin-600 font-semibold' : 'text-gray-700'}`}>
              {child.title}
            </a>
          ))}
        </div>
      </div>

      <!-- Bahasa Dropdown -->
      <div class="relative group">
        <button class="btn-ghost text-sm font-medium py-2 flex items-center gap-1">
          <i class="fas fa-language text-sm" />
          <span class="hidden xl:inline">Bahasa</span>
          <i class="fas fa-chevron-down text-[10px] ml-0.5 opacity-50 group-hover:rotate-180 transition-transform" />
        </button>
        <div class="absolute top-full right-0 mt-1 bg-white rounded-xl border border-gray-100 shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 min-w-[180px] py-2">
          <a href={currentUrl} data-lang="id" class="flex items-center gap-2 px-4 py-2 text-sm text-deepin-600 font-semibold bg-deepin-50 hover:bg-deepin-100 transition-colors">
            {langLabel['id']}
          </a>
          {['en', 'zh-CN'].map((code) => (
            <a href={`https://translate.google.com/translate?sl=id&tl=${code}&u=${encodeURIComponent(currentUrl)}`} data-lang={code} class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 transition-colors">
              {langLabel[code]}
            </a>
          ))}
          <hr class="my-1 border-gray-100" />
          {Object.entries(langMore).map(([code, label]) => (
            <a href={`https://translate.google.com/translate?sl=id&tl=${code}&u=${encodeURIComponent(currentUrl)}`} data-lang={code} class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 transition-colors">
              {label}
            </a>
          ))}
        </div>
      </div>

      <!-- Donasi CTA (paling kanan) -->
      <a href="https://donasi.deepin.id" class="btn-primary text-sm py-2 px-4 ml-3 !rounded-lg">
        <i class="fas fa-heart text-xs" /> Donasi
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      class="lg:hidden flex flex-col gap-1.5 p-2 z-50"
      id="menu-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="block w-6 h-0.5 bg-gray-700 rounded transition-transform origin-center menu-bar" />
      <span class="block w-6 h-0.5 bg-gray-700 rounded transition-opacity menu-bar" />
      <span class="block w-6 h-0.5 bg-gray-700 rounded transition-transform origin-center menu-bar" />
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div class="hidden lg:hidden fixed inset-0 top-[72px] bg-white z-40 overflow-y-auto" id="mobile-menu">
    <div class="container-main py-6 space-y-2">
      {MAIN_NAV.map((item) => (
        item.children ? (
          <details class="group">
            <summary class="flex items-center justify-between py-3 px-4 rounded-xl text-gray-800 font-medium cursor-pointer hover:bg-gray-50">
              {item.title}
              <i class="fas fa-chevron-down text-xs opacity-40 group-open:rotate-180 transition-transform" />
            </summary>
            <div class="ml-4 mt-1 space-y-1">
              {item.children.map((child) => (
                <a href={child.url} class="block py-2.5 px-4 rounded-lg text-sm text-gray-600 hover:bg-gray-50">
                  {child.title}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a href={item.url} class="block py-3 px-4 rounded-xl text-gray-800 font-medium hover:bg-gray-50" target="_blank" rel="noopener">
            {item.title}
          </a>
        )
      ))}
      <a href="https://donasi.deepin.id" class="flex items-center justify-center gap-2 mt-4 py-3 px-4 rounded-xl bg-deepin-600 text-white font-semibold">
        <i class="fas fa-heart text-sm" /> Donasi
      </a>
      <!-- Tentang deepin -->
      <details class="group">
        <summary class="flex items-center justify-between py-3 px-4 rounded-xl text-gray-800 font-medium cursor-pointer hover:bg-gray-50">
          Tentang deepin
          <i class="fas fa-chevron-down text-xs opacity-40 group-open:rotate-180 transition-transform" />
        </summary>
        <div class="ml-4 mt-1 space-y-1">
          {ABOUT_NAV[0].children?.map((child) => (
            <a href={child.url} class={`block py-2.5 px-4 rounded-lg text-sm hover:bg-gray-50 ${child.highlight ? 'text-deepin-600 font-semibold' : 'text-gray-600'}`}>
              {child.title}
            </a>
          ))}
        </div>
      </details>

      <!-- Bahasa Mobile -->
      <details class="group">
        <summary class="flex items-center justify-between py-3 px-4 rounded-xl text-gray-800 font-medium cursor-pointer hover:bg-gray-50">
          <span class="flex items-center gap-2"><i class="fas fa-language text-sm" /> Bahasa</span>
          <i class="fas fa-chevron-down text-xs opacity-40 group-open:rotate-180 transition-transform" />
        </summary>
        <div class="ml-4 mt-1 space-y-1">
          <a href={currentUrl} data-lang="id" class="block py-2.5 px-4 rounded-lg text-sm text-deepin-600 font-semibold bg-deepin-50">
            {langLabel['id']}
          </a>
          {[...['en', 'zh-CN'], ...Object.keys(langMore)].map((code) => (
            <a href={`https://translate.google.com/translate?sl=id&tl=${code}&u=${encodeURIComponent(currentUrl)}`} data-lang={code} class="block py-2.5 px-4 rounded-lg text-sm text-gray-600 hover:bg-gray-50">
              {langLabel[code] || langMore[code]}
            </a>
          ))}
        </div>
      </details>
    </div>
  </div>

  <!-- Backdrop -->
  <div class="hidden lg:hidden fixed inset-0 top-[72px] bg-black/30 z-30" id="menu-backdrop"></div>

  <!-- Google Translate (hidden) -->
  <div id="google_translate_element" style="display:none"></div>
</header>

<!-- Google Translate: event delegation on [data-lang] links -->
<script>
  function googleTranslateElementInit() {
    new google.translate.TranslateElement({
      pageLanguage: 'id',
      includedLanguages: 'id,en,zh-CN,ja,ko,ar,ru,pt,fr,de,es',
      layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
      autoDisplay: false,
    }, 'google_translate_element');
  }

  // Intercept clicks on translate links
  document.addEventListener('click', function(e) {
    var link = e.target.closest('[data-lang]');
    if (!link) return;
    var lang = link.dataset.lang;
    if (!lang) return;

    var combo = document.querySelector('.goog-te-combo');
    if (combo) {
      e.preventDefault();
      if (lang === 'id') {
        for (var i = 0; i < combo.options.length; i++) {
          if (combo.options[i].value === 'id') {
            combo.selectedIndex = i;
            combo.dispatchEvent(new Event('change'));
            return;
          }
        }
      } else {
        combo.value = lang;
        combo.dispatchEvent(new Event('change'));
      }
    }
    // If combo not ready, let <a href> redirect naturally
  });

  // Load Google Translate
  if (!document.querySelector('script[src*="translate_a/element.js"]')) {
    const s = document.createElement('script');
    s.src = '//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
    document.head.appendChild(s);
  }
</script>

<script>
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const backdrop = document.getElementById('menu-backdrop')!;
  const bars = toggle.querySelectorAll('.menu-bar') as NodeListOf<HTMLElement>;

  function closeMenu() {
    menu.classList.add('hidden');
    backdrop.classList.add('hidden');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    bars[0].style.transform = '';
    bars[1].style.opacity = '1';
    bars[2].style.transform = '';
  }

  function openMenu() {
    menu.classList.remove('hidden');
    backdrop.classList.remove('hidden');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    bars[0].style.transform = 'rotate(45deg) translate(5px, 5px)';
    bars[1].style.opacity = '0';
    bars[2].style.transform = 'rotate(-45deg) translate(5px, -5px)';
  }

  toggle.addEventListener('click', () => {
    menu.classList.contains('hidden') ? openMenu() : closeMenu();
  });
  backdrop.addEventListener('click', closeMenu);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.classList.contains('hidden')) closeMenu();
  });

  // Header shadow on scroll
  const header = document.getElementById('header')!;
  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      header.classList.add('shadow-md');
    } else {
      header.classList.remove('shadow-md');
    }
  });
</script>
